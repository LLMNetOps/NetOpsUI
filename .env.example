# Copy to .env and adjust (read by docker compose; .env is gitignored).

# Port the UI listens on.
UI_PORT=3000

# NetOps Agent REST API (repo: palapa-agent). Start it on a free port, e.g.:
#   PALAPA_CONFIG_PATH=~/.palapa/config.yaml uv run uvicorn palapa.gateway.api:app --host 127.0.0.1 --port 8100
# (port 8000 on this host is taken by the mikrotik-mcp container)
NETOPS_AGENT_URL=http://127.0.0.1:8100

# Hermes gateway `api_server` platform (default port 8642).
# HERMES_API_KEY must equal API_SERVER_KEY in ~/.hermes/.env — nginx injects it
# so it never reaches the browser.
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Where the manager keeps its database and SOUL.md backups. Default: ./data
# (committed with a .gitkeep so it is owned by you, not root). Point it elsewhere
# for a separate instance, e.g. when testing.
# DATA_DIR=./data

# Manager service port (loopback only, reached through the UI's /api/).
MANAGER_PORT=8200

# Home directories of the two backends (absolute paths).
NETOPS_AGENT_HOME=/home/llmnetops/.palapa
HERMES_HOME=/home/llmnetops/.hermes

# Container user for the manager, so files it writes into the backends' skill
# folders stay owned by you. Get yours with: id -u / id -g
HOST_UID=1006
HOST_GID=1006
