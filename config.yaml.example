# Konfigurasi MikroTik DHCP Lease Agent — CONTOH
# ---------------------------------------------------
# Salin file ini ke config.yaml dan sesuaikan nilainya:
#   cp config.yaml.example config.yaml
#
# PERINGATAN: Jangan commit config.yaml ke repository publik
# karena berisi password SSH!
# File ini (config.yaml.example) aman untuk di-commit.

ssh:
  username: netadmin          # Username SSH router MikroTik
  password: YOUR_SSH_PASSWORD # Ganti dengan password SSH yang sebenarnya
  timeout: 15                 # Timeout koneksi SSH dalam detik
  port: 22                    # Port SSH (default 22)

routers:
  # ── Contoh router RouterOS v7 ─────────────────────────────
  - name: DTI
    host: 10.39.0.1
    ros_version: 7            # RouterOS v7: gunakan sintaks /ip/dhcp-server/lease/print
    dhcp_servers:
      - dhcp-lab-tik          # Nama DHCP server di router (bisa lebih dari satu)

  # ── Contoh router RouterOS v6 ─────────────────────────────
  - name: FAKULTAS-A
    host: 192.168.1.1
    ros_version: 6            # RouterOS v6: gunakan sintaks ip dhcp-server lease print
    dhcp_servers:
      - server-lab

  # ── Contoh router dengan beberapa DHCP server ─────────────
  # Router yang memiliki lebih dari satu DHCP server didaftarkan
  # sebagai entri terpisah dengan nama yang sama.
  - name: FAKULTAS-B
    host: 192.168.2.1
    ros_version: 6
    dhcp_servers:
      - dhcp-vlan-100

  - name: FAKULTAS-B
    host: 192.168.2.1
    ros_version: 6
    dhcp_servers:
      - dhcp-vlan-200

  - name: FAKULTAS-B
    host: 192.168.2.1
    ros_version: 6
    dhcp_servers:
      - dhcp-vlan-300

  # ── Tambahkan router lain di bawah ini ────────────────────
  # - name: NAMA_ROUTER
  #   host: IP_ROUTER
  #   ros_version: 6   # atau 7
  #   dhcp_servers:
  #     - nama-dhcp-server
